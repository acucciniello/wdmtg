{
  "name": "wdmtg-desktop",
  "productName": "WDMTG",
  "version": "0.1.0",
  "description": "Where Did My Time Go \u2014 tracks every second across your Mac and iPhone and shows where the time is lost.",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "node src/dev-server.js --demo",
    "test": "node --test --no-warnings \"test/*.test.js\"",
    "dist": "electron-builder --publish never"
  },
  "engines": {
    "node": ">=22.13"
  },
  "build": {
    "appId": "app.wdmtg.desktop",
    "productName": "WDMTG",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/get-windows/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "WDMTG reads the address of the page you have open in your browser so it can tell YouTube from your deal spreadsheet."
      }
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "dmg": {
      "sign": false
    },
    "artifactName": "WDMTG-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "get-windows": "^10.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
